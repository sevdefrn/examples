@page
@model StudentDemoFrontend.Pages.GirisModel
@{
    Layout = "_Layout";
}
<div class="login-wrapper d-flex align-items-center justify-content-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                    <div class="bg-primary py-3"></div>

                    <div class="card-body p-4 p-md-5">
                        <div class="text-center mb-4">
                            <div class="display-6 text-primary mb-2">
                                <i class="bi bi-person-circle"></i>
                            </div>
                            <h2 class="fw-bold text-dark">Hoş Geldiniz</h2>
                            <p class="text-muted small">Lütfen bilgilerinizi girerek devam edin</p>
                        </div>

                        <form>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control rounded-3" id="floatingInput" placeholder="Kullanıcı Adı">
                                <label for="floatingInput"><i class="bi bi-person me-2"></i>Kullanıcı Adı</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="password" class="form-control rounded-3" id="floatingPassword" placeholder="Şifre">
                                <label for="floatingPassword"><i class="bi bi-lock me-2"></i>Şifre</label>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="rememberMe">
                                    <label class="form-check-label small" for="rememberMe">Beni Hatırla</label>
                                </div>
                                <a href="#" class="text-primary small text-decoration-none fw-semibold">Şifremi Unuttum</a>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm py-2 mb-3">
                                Giriş Yap <i class="bi bi-arrow-right-short ms-1"></i>
                            </button>

                            <div class="text-center">
                                <p class="text-muted small mb-0">Hesabınız yok mu? <a href="#" class="text-primary fw-bold text-decoration-none">Kayıt Ol</a></p>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <p class="text-muted small">&copy; 2026 StudentDemo. Tüm hakları saklıdır.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Giriş sayfasını tam ekran yapma ve arka plan rengi */
    .login-wrapper {
        min-height: 80vh; /* Navbar'dan sonraki alanı kaplaması için */
        background: radial-gradient(circle at top left, #f8f9fa 0%, #e9ecef 100%);
    }

    /* Input focus olduğunda kenar rengini değiştirme */
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.15);
    }

    /* Kartın yavaşça açılma efekti */
    .card {
        animation: fadeInUp 0.6s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>