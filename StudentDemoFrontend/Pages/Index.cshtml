@page
@model IndexModel 
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-book me-2"></i>Kitap Listesi</h5>
                    <span class="badge bg-light text-primary">@Model.Books?.Count</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Books != null && Model.Books.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var book in Model.Books)
                            {
                                <li class="list-group-item list-group-item-action d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 text-dark fw-bold">@book.Title</h6>
                                        <small class="text-muted">ID: #@book.Id</small>
                                    </div>
                                    <span class="badge bg-info rounded-pill">Mevcut</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 text-center">
                            <p class="text-muted mb-0">📚 Henüz kayıtlı kitap bulunamadı.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Yazar Listesi</h5>
                    <span class="badge bg-light text-success">@Model.Authors?.Count</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Authors != null && Model.Authors.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var author in Model.Authors)
                            {
                                <li class="list-group-item list-group-item-action">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3 bg-light d-flex align-items-center justify-content-center border rounded-circle" style="width: 40px; height: 40px;">
                                            <span class="text-success fw-bold">@(author.Name?.Substring(0, 1).ToUpper())</span>
                                        </div>
                                        <div>
                                            <h6 class="mb-0">@author.Name</h6>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="p-4 text-center">
                            <p class="text-muted mb-0">✍️ Henüz kayıtlı yazar bulunamadı.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* Küçük bir stil dokunuşu *@
<style>
    .card { transition: transform 0.2s; }
    .card:hover { transform: translateY(-5px); }
    .list-group-item { border-left: 3px solid transparent; }
    .list-group-item:hover { border-left: 3px solid #0d6efd; background-color: #f8f9fa; }
</style>


