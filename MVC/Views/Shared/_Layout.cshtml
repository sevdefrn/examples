<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alara Patisserie</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
</head>
<body>

    <!-- SOL SABİT MENÜ -->
    <div class="d-flex flex-column p-3 text-white"
         style="width: 220px; height: 100vh; position: fixed; left: 0; top: 0; background-color: #e1bee7;">

        <!-- LOGO -->

        <a class="navbar-brand d-flex align-items-center mb-4" href="/">
            <img src="~/images/logo.jpg" width="35" height="35" class="me-2 rounded" />
            <span class="fw-bold" style="color: #000000;">Alara Pastane</span>
        </a>

        <!-- MENÜ -->
        <div class="col-auto">
            <button type="submit" class="btn btn-secondary mb-3">Giriş yap</button>
        </div>
        <ul class="navbar-nav flex-grow-1">
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Home" asp-action="Privacy">About Us</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Products</a>
            </li>
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="SignIn" asp-action="Create">Öğrenciler</a>
            </li>
        </ul>
        <div class="socialmedia">
            <ul style="list-style:none; padding:0; margin:0; display:flex; gap:10px;">
                <li>
                    <a href="https://www.facebook.com" target="_blank">
                        <img src="~/images/facebook.png" style="width:25px; height:25px;" />
                    </a>
                </li>
                <li>
                    <a href="https://www.instagram.com" target="_blank">
                        <img src="~/images/instagram.png" style="width:25px; height:25px;" />
                    </a>
                </li>
                <li>
                    <a href="https://tr.linkedin.com" target="_blank">
                        <img src="~/images/linkedin.png" style="width:25px; height:25px;" />
                    </a>
                </li>
                <li>
                    <a href="https://x.com/?lang=tr" target="_blank">
                        <img src="~/images/twitter.png" style="width:25px; height:25px;" />
                    </a>
                </li>
                <li>
                    <a href="https://web.whatsapp.com" target="_blank">
                        <img src="~/images/whatsapp.png" style="width:25px; height:25px;" />
                    </a>
                </li>
            </ul>
        </div>

        <footer class="mt-auto pt-3" style="text-dark">
            <small>&copy; <span style="color: black;">2025</span> • <a class="text-dark" asp-action="Privacy">Privacy</a></small>
        </footer>

    </div>

    <!-- SAĞ ANA SAYFA İÇERİK ALANI -->
    <main class="p-4" style="margin-left:220px; background-color:#fbcfe8; min-height:100vh;">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


