
@{
    Layout = null;
}
@model MVC.Models.ViewModels.SignInViewModels

@{
    if (@Model.userName != null)
    {
        <div class="">
            <h2>Hoşgeldiniz @Model.userName</h2>
        </div>
        <a asp-controller="Home" asp-action="Index" type="button" class="btn btn-secondary">Çıkış</a>


    }
    {
        <a asp-controller="SignIn" asp-action="Create" type="button" class="btn btn-secondary">Giriş yap</a>
    }
}
