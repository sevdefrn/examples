
@{
    ViewData["Title"] = "Erorr";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1></h1>
<!-- Modal -->
<div class="modal fade" id="errorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="background-color: #e1bee7;">
            <div class="modal-header">
                <h5 class="modal-title">Hata</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Kullanıcı bulunamadı. Tekrar deneyiniz!!</p>
            </div>
            <div class="modal-footer">
                <a asp-controller="SignIn" asp-action="Create" class="btn btn-secondary">
                    Geri Dön
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var modal = new bootstrap.Modal(document.getElementById('errorModal'));
        modal.show();
    });
</script>

    

