@using MVC.Models.ViewModels

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model SignInViewModels
<h1></h1>



<form method="post">

    <div class="card" style="width: 18rem; background-color: #e1bee7;">
        <div class="card-body">
            <h5 class="card-title">Kullanıcı Girişi</h5>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="col-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-label">
                <div id="emailHelp" class="text-danger">
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>
            <div class="col-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-label">
                <div id="emailHelp" class="text-danger">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
            <div class="col-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-label">
                <div id="emailHelp" class="text-danger">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <form asp-controller="Home" asp-action="Index" method="get">
                <button type="submit" class="btn btn-secondary">Giriş Yap</button>
            </form>
        </div>
    </div>

</form>

