@using MVC.Models.ViewModels
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model List<Product>

<div class="btn-group" role="group" aria-label="Basic mixed styles example">
    <a asp-controller="Product" asp-action="Create" type="button" class="btn btn-secondary">Ürün ekle</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Ürün Adı</th>
            <th scope="col">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>
                    <a href="/Product/Update/@product.Id" type="button" class="btn btn-secondary">Güncelle</a>  
                    <a href="/Product/Delete/@product.Id" type="button" class="btn btn-danger">Sil</a>
                </td>
            </tr>
        }

    </tbody>
</table>

