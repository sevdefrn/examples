@using MVC.Models.ViewModels
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Ürün Ekle</h1>
@model Product

<form method="post" class="row g-3">
    <div class="col-auto">
        <label for="inputPassword2" class="visually-hidden">Ürün adı</label>
        <input asp-for="Name" class="form-control" id="inputPassword2" placeholder="Ürün adı">
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary mb-3">Kaydet</button>
    </div>
</form>


