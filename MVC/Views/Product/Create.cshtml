@using MVC.Models.ViewModels
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Add product</h1>
@model Product

<form method="post" class="row g-3">
    <div class="col-auto">
        <label for="inputPassword2" class="visually-hidden">Product name</label>
        <input asp-for="Name" class="form-control" id="inputPassword2" placeholder="Product Name">
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary mb-3">Save</button>
    </div>
</form>


