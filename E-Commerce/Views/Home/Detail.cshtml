@using E_Commerce.Models
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model E_Commerce.Models.Product


@{
    var products = Model;
}


@{
    var image = Model.ProductImages.FirstOrDefault(x => x.IsActive);
    var color = Model.ProductColors ?? new List<ProductColor>();
    var size = Model.ProductSizes ?? new List<ProductSize>();
    var propert = Model.ProductProperties ?? new List<ProductProperty>();


    <img src="@image?.ImageUrl" alt="(@Model.Name)" />
}

@foreach (var p in propert)
{
    <div class="card shadow-sm mb-4" style="max-width: 22rem; border-radius:16px;">
        <div class="card-body">

            <!-- SEPETE EKLE -->
            <form asp-controller="Cart"
                  asp-action="Add"
                  method="post"
                  class="mb-3">

                <input type="hidden" name="productId" value="@p.Id" />

                <button type="submit"
                        class="btn w-100"
                        style="
                                    background-color:#800020;
                                    color:#FFF3E6;
                                    border-radius:20px;
                                    font-weight:600;
                                ">
                    🛒 Sepete Ekle
                </button>
            </form>
            <h4>
                <div class="price">
                    @Model.Price.ToString("C2") 
                </div>
            </h4>
            

            <!-- AÇIKLAMA -->
            <h6 style="
                        font-weight:700;
                        color:#800020;
                        margin-bottom:10px;
                    ">
                Açıklama
            </h6>

            <p style="margin-bottom:6px;">
                <strong>Ürün:</strong> @Model.Name
            </p>

            <!-- RENKLER -->
            @if (color.Any())
            {
                <p style="margin-bottom:6px;">
                    <strong>Renk:</strong>
                    @string.Join(", ", color.Select(x => x.ColorId))
                </p>
            }

            <!-- BEDENLER -->
            @if (size.Any())
            {
                <p style="margin-bottom:6px;">
                    <strong>Boyut:</strong>
                    @string.Join(", ", size.Select(x => x.SizeId))
                </p>
            }

            <hr />


            <div coll="">
                <!-- ÖZELLİKLER -->
                <h6 style="
                            font-weight:700;
                            color:#800020;
                            margin-bottom:8px;
                        ">
                    Özellikler
                </h6>

                <p style="margin-bottom:4px;">
                    <strong>İçerik:</strong> @p.Attr
                </p>

                <p style="margin-bottom:4px;">
                    <strong>Oran:</strong> @p.Value
                </p>

                <p style="margin-top:8px; color:#555;">
                    @Model.Description
                </p>
            </div>
            

        </div>
    </div>
}




