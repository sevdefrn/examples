@using E_Commerce.Models

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model SignIn

<h1></h1>

<div class="d-flex justify-content-center align-items-center vh-100">
    <form method="post">
        <div class="card shadow-lg" style="width: 24rem; background-color: #d1e7dd;">
            <div class="card-body p-4">
                <h4 class="card-title text-center mb-4">Giriş Yap</h4>

                <div class="mb-3">
                    <label class="form-label">Kullanıcı Adı</label>
                    <input class="form-control form-control-lg" name="userName">
                </div>

                <div class="mb-3">
                    <label class="form-label">Şifre</label>
                    <input type="password" class="form-control form-control-lg" name="Password">
                </div>

                <div class="mb-4 form-check">
                    <input type="checkbox" class="form-check-input" name="rememberMe" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">
                        Beni Hatırla
                    </label>
                </div>

                <button type="submit" class="btn btn-outline-secondary" style="color:#800020">
                    Giriş Yap
                </button>
            </div>
        </div>
    </form>
</div>
