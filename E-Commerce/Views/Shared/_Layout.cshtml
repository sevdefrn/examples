<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E_Commerce</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/E_Commerce.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <style>
            body {
                margin: 0;
                padding: 0;
            }

            header {
                margin: 0;
                padding: 0;
                background-color: #EAF7F2;
            }

            nav.navbar {
                margin-bottom: 0 !important;
                padding-bottom: 0;
                border-bottom: none !important;
                background-color: #ffffff !important; /* body ile aynı */
            }

            main, .container, .container-fluid {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }

            /* Hover dropdown */
            nav .dropdown:hover > .dropdown-menu {
                display: block;
                margin-top: 0;
            }

            .navbar .nav-link {
                color: #000000;
                font-weight: 600;
            }

            .dropdown-menu {
                border-radius: 0;
            }
        </style>
        <style>
            nav ul li {
                cursor: pointer;
                border-bottom: 3px solid transparent;
            }

                nav ul li:hover {
                    border-bottom: 3px solid #000000;
                    background-color: #f8f9fa;
                }
        </style>
        <div class="container-fluid py-3">
            <div class="row align-items-center">

                <!-- LOGO -->
                <div class="col-md-3">
                    <img src="~/images/logo.jpg" width="35" height="35" class="me-2 rounded" />
                    <a class="navbar-brand fw-bold fs-3" href="/" style="color:#000000;">
                        Alara Pastane
                    </a>
                </div>

                <!-- SEARCH -->
                <div class="col-md-6">
                    <form class="d-flex" role="search">
                        <input class="form-control me-2" type="search" placeholder="Ara" />
                        <button class="btn btn-outline-dark" type="submit">Ara</button>
                    </form>
                </div>

                <!-- USER -->
                <div class="col-md-3 d-flex justify-content-end gap-2">
                    <button class="btn btn-outline-secondary rounded-pill">
                        Giriş Yap
                    </button>
                    <button class="btn btn-secondary rounded-pill">
                        Sepetim
                    </button>
                </div>

            </div>
        </div>
        <nav class="border-top">
            <ul class="nav justify-content-center fw-semibold">

                    <ul class="nav justify-content-center fw-semibold">

                        <!-- PASTALAR -->
                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Pastalar
                            </a>

                            <!-- ALT MENÜ (AÇILAN KISIM) -->
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Doğum Günü Pastaları</a></li>
                                <li><a class="dropdown-item" href="#">Nişan Pastaları</a></li>
                                <li><a class="dropdown-item" href="#">Özel Tasarım</a></li>
                            </ul>
                        </li>

                        <!-- KEKLER -->
                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Kekler
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Islak Kek</a></li>
                                <li><a class="dropdown-item" href="#">Meyveli Kek</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Kurabiyeler
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Islak Kek</a></li>
                                <li><a class="dropdown-item" href="#">Meyveli Kek</a></li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Cheesecake
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Islak Kek</a></li>
                                <li><a class="dropdown-item" href="#">Meyveli Kek</a></li>
                            </ul>
                        </li>


                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Cupcake
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Islak Kek</a></li>
                                <li><a class="dropdown-item" href="#">Meyveli Kek</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Makaron
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Islak Kek</a></li>
                                <li><a class="dropdown-item" href="#">Meyveli Kek</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Sufle
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Islak Kek</a></li>
                                <li><a class="dropdown-item" href="#">Meyveli Kek</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Ekler
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Islak Kek</a></li>
                                <li><a class="dropdown-item" href="#">Meyveli Kek</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Profiterol
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Islak Kek</a></li>
                                <li><a class="dropdown-item" href="#">Meyveli Kek</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown px-3 py-2">
                            <a class="nav-link text-dark" href="#">
                                Çikolata
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">Islak Kek</a></li>
                                <li><a class="dropdown-item" href="#">Meyveli Kek</a></li>
                            </ul>
                        </li>
                    </ul>
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Alara Pastene - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizilik</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
