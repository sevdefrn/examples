@using E_Commerce.Models
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E_Commerce</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/E_Commerce.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <style>
            body {
                margin: 0;
                padding: 0;
            }

            header {
                background-color: #d1e7dd;
                margin-bottom: 20px;
            }
        </style>
        <div class="container-fluid py-3">
            <div class="row align-items-center">

                <!-- LOGO -->
                <div class="col-md-3">
                    <img src="~/img/logo.jpg" width="35" height="35" class="me-2 rounded" />
                    <a class="navbar-brand fw-bold fs-3" href="/" style="color:#800020;">
                        Alara Pastane
                    </a>
                </div>

                <!-- SEARCH -->
                <div class="col-md-6">
                    <form class="d-flex" role="search">
                        <input class="form-control me-2" type="search" placeholder="Ara" />
                        <button class="btn btn-outline-secondary" style="color:#800020" type="submit">Ara</button>
                    </form>
                </div>

                <!-- USER -->
                <div class="col-md-3 d-flex justify-content-end gap-2">
                    <partial name="_AdminLayout" model="new E_Commerce.Models.SignIn()" />

                    <button class="btn btn-outline-secondary rounded-pill" style="color:#800020">
                        Sepetim
                    </button>
                </div>

            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container" style="color:#800020">
            &copy; 2026 - Alara Pastene - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizilik</a>
        </div>
        <div class="socialmedia">
            <ul style="list-style:none; padding:0; margin:0; display:flex; gap:10px; justify-content:flex-end;">
                <li>
                    <a href="https://www.facebook.com" target="_blank">
                        <img src="~/img/facebook.png" style="width:25px; height:25px;" />
                    </a>
                </li>
                <li>
                    <a href="https://www.instagram.com" target="_blank">
                        <img src="~/img/instagram.png" style="width:25px; height:25px;" />
                    </a>
                </li>
                <li>
                    <a href="https://tr.linkedin.com" target="_blank">
                        <img src="~/img/linkedin.png" style="width:25px; height:25px;" />
                    </a>
                </li>
                <li>
                    <a href="https://x.com/?lang=tr" target="_blank">
                        <img src="~/img/twitter.png" style="width:25px; height:25px;" />
                    </a>
                </li>
                <li>
                    <a href="https://web.whatsapp.com" target="_blank">
                        <img src="~/img/whatsapp.png" style="width:25px; height:25px;" />
                    </a>
                </li>
            </ul>
        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
